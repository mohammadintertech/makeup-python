@app.route('/apply', methods=['POST'])
def apply_makeup():
    try:
        if not request.files:
            return jsonify({"error": "No image provided"}), 400

        uploaded = next(iter(request.files.values()))
        image_bytes = uploaded.read()
        image_np = np.frombuffer(image_bytes, np.uint8)
        image = cv2.imdecode(image_np, cv2.IMREAD_COLOR)

        if image is None:
            return jsonify({"error": "Invalid image"}), 400

        image = resize_image_if_needed(image)
        result = apply_makeup_pipeline(image, request.form)

        success, buffer = cv2.imencode(".png", result)
        if not success:
            return jsonify({"error": "Failed to encode image"}), 500

        return Response(
            buffer.tobytes(),
            mimetype="image/png",
            headers={'Content-Disposition': f'inline; filename="{uploaded.filename}"'}
        )
    except Exception as e:
        logger.error(str(e))
        return jsonify({"error": str(e)}), 500

@app.route('/apply_base64', methods=['POST'])
def apply_makeup_base64():
    try:
        if not request.files:
            return jsonify({"error": "No image provided"}), 400

        uploaded = next(iter(request.files.values()))
        image_bytes = uploaded.read()
        image_np = np.frombuffer(image_bytes, np.uint8)
        image = cv2.imdecode(image_np, cv2.IMREAD_COLOR)

        if image is None:
            return jsonify({"error": "Invalid image"}), 400

        result = apply_makeup_pipeline(image, request.form)
        success, buffer = cv2.imencode(".png", result)
        image_base64 = base64.b64encode(buffer).decode('utf-8')

        return jsonify({"success": True, "image": image_base64, "format": "png"})
    except Exception as e:
        logger.error(str(e))
        return jsonify({"error": str(e)}), 500

