@app.route('/oasis/<path:endpoint>', methods=['GET','POST'])
def oasis_proxy(endpoint):
    try:
        target_url = f"{OASIS_API_URL}/{endpoint}"
        if request.method=='GET':
            r = requests.get(target_url, params=request.args, timeout=15)
        else:
            r = requests.post(target_url, json=request.json, data=request.form, timeout=15)
        try:
            return jsonify(r.json()), r.status_code
        except:
