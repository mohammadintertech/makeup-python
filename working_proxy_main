def resize_image_if_needed(image):
    h, w = image.shape[:2]
    if max(h, w) > MAX_IMAGE_SIZE:
        scale = MAX_IMAGE_SIZE / max(h, w)
        return cv2.resize(image, (int(w * scale), int(h * scale)))
    return image

